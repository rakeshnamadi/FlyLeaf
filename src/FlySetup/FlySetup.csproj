<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Built twice by installer\build.ps1. Without PayloadDir the result is the small uninstaller.
    With PayloadDir it embeds every component (and that uninstaller) and becomes Flyleaf-Setup.exe.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Flyleaf-Setup</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Flyleaf\Flyleaf.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(PayloadDir)' != ''">
    <EmbeddedResource Include="$(PayloadDir)\Flyleaf.exe" LogicalName="payload/Flyleaf.exe" />
    <EmbeddedResource Include="$(PayloadDir)\FlyWatcher.exe" LogicalName="payload/FlyWatcher.exe" />
    <EmbeddedResource Include="$(PayloadDir)\FlyShell.dll" LogicalName="payload/FlyShell.dll" />
    <EmbeddedResource Include="$(PayloadDir)\Uninstall-Flyleaf.exe" LogicalName="payload/Uninstall-Flyleaf.exe" />
  </ItemGroup>
</Project>
